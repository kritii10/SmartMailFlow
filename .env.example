PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
# Optional local fallback when REDIS_URL is not set:
# REDIS_HOST=localhost
# REDIS_PORT=6379
EMAIL_QUEUE_NAME=email-scheduler
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
AUTH_COOKIE_NAME=reachinbox_session
OAUTH_STATE_COOKIE_NAME=reachinbox_oauth_state
OAUTH_STATE_TTL_MS=600000
SESSION_TTL_MS=604800000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
